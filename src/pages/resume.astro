---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Resume" description="View and download Lot Holmstead's resume, including education, experience, skills, projects, and contact information.">
  <section class="resume-intro">
    <div class="container resume-intro-grid">
      <div>
        <p class="section-kicker"><span>01</span> RESUME</p>
        <h1>Experience, education,<br />and selected work.</h1>
        <p>A one-page overview of my work in SaaS, product development, teaching, and Information Systems.</p>
      </div>
      <aside class="resume-action-card" aria-label="Resume actions">
        <p><span>CURRENT VERSION</span><strong>Updated November 2026</strong></p>
        <div>
          <a class="button button-primary" href={profile.resumeUrl} target="_blank" rel="noreferrer">Open full screen ↗</a>
          <a class="button button-secondary" href={profile.resumeUrl} download>Download PDF</a>
        </div>
        <a class="resume-experience-link" href="/#experience">View website experience →</a>
      </aside>
    </div>
  </section>

  <section class="resume-document-section" aria-labelledby="resume-document-title">
    <div class="container resume-document-container">
      <div class="resume-toolbar">
        <div><span id="resume-document-title">LOT HOLMSTEAD</span><strong>Professional resume · One page</strong></div>
      </div>
      <div class="resume-preview">
        <a href={profile.resumeUrl} target="_blank" rel="noreferrer" aria-label="Open Lot Holmstead’s resume as a full-screen PDF">
          <img src="/images/resume-preview.jpg" alt="Preview of Lot Holmstead’s one-page resume." width="1020" height="1320" />
          <span>Open full-screen PDF ↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
