---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FlagshipVisual from '../components/FlagshipVisual.astro';
import ProfileIcon from '../components/ProfileIcon.astro';
import { profile, skills } from '../data/profile';
import { projects } from '../data/projects';
const flagship = projects.find(project => project.slug === 'athlete-recruiting-platform')!;

const otherProjects = projects
  .filter((project) => project.status === 'Completed' && project.featured && project.slug !== 'personal-portfolio-website')
  .sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99));
---

<BaseLayout title="Product Management & Tech Startups" bodyClass="portfolio-v2" description="Lot Holmstead is a BYU Information Systems student pursuing product management and tech startup roles. Explore his products, technical projects, experience, and resume.">
  <section class="intro-v2">
    <div class="container">
      <div class="intro-layout">
        <div class="intro-main">
          <h1>Lot Holmstead</h1>
          <div class="intro-position"><p class="intro-program">BYU Information Systems</p><p class="intro-focus">Product management <span aria-hidden="true">/</span> Tech startups</p></div>
          <div class="intro-bottom"><p>SEEKING <strong>Product management &amp; tech startup roles</strong></p><p>GRADUATING <strong>April 2028</strong></p></div>
          <a class="button button-primary intro-contact-button" href="/contact/">Contact Me</a>
          <div class="intro-profile-links" aria-label="Resume and professional profiles"><a href="/resume/" aria-label="View my resume" title="Resume"><ProfileIcon name="resume" /></a><a href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="Visit my LinkedIn profile (opens in a new tab)" title="LinkedIn"><ProfileIcon name="linkedin" /></a><a href={profile.links.github} target="_blank" rel="noreferrer" aria-label="Visit my GitHub profile (opens in a new tab)" title="GitHub"><ProfileIcon name="github" /></a></div>
        </div>
        <figure class="intro-portrait"><img src="/images/lot-headshot.webp" alt="Professional portrait of Lot Holmstead." width="1000" height="1500" fetchpriority="high" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <section class="projects-banner" id="projects" aria-labelledby="projects-title"><div class="container"><h2 id="projects-title">PROJECTS</h2><span aria-hidden="true">↓</span></div></section>
  <section class="flagship-section">
    <div class="container">
      <div class="work-section-label"><span>FEATURED PROJECT</span><span>FOUNDER · DEVELOPER</span></div>
      <a class="flagship-image-link" href="https://tyholmstead.com" target="_blank" rel="noreferrer" aria-label="View Ty Holmstead’s live athlete website (opens in a new tab)"><div class="flagship-browser"><span class="browser-dots" aria-hidden="true">● ● ●</span><span>tyholmstead.com</span><span>LIVE ATHLETE WEBSITE ↗</span></div><FlagshipVisual image="/images/projects/notawalkon.webp" /></a>
      <div class="flagship-description">
        <div><h2>Custom Athlete<br />Websites</h2><div class="flagship-skills"><h3>Skills</h3><div class="tag-list" aria-label="Skills used in Custom Athlete Websites">{flagship.tags.map(tag=><span>{tag}</span>)}</div></div></div>
        <div><p class="flagship-summary">Custom recruiting websites with athletic stats, highlight film, schedules, and coach contact information in one shareable profile.</p><a class="button button-primary flagship-visit" href="https://tyholmstead.com" target="_blank" rel="noreferrer">View live website <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3l-9 9M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" /></svg><span class="sr-only"> (opens in a new tab)</span></a></div>
      </div>
    </div>
  </section>

  <section class="other-work-section"><div class="container"><div class="project-grid home-project-grid">{otherProjects.map(project => <ProjectCard project={project} compact />)}</div></div></section>

  <section class="experience-v2" id="experience">
    <div class="container">
      <div class="work-section-label"><span>EXPERIENCE</span><a href="/resume/">FULL RESUME ↗</a></div>
      <div class="experience-v2-list">
        <article class="upcoming-role"><div class="experience-date">STARTING NOV 2, 2026</div><div><h3>Intern</h3><p class="experience-company">Redo</p><p>I’ll help automate iPhone setup for Redo’s iMessage infrastructure, maintain secure connections between devices and servers, and write code to support reliable operations.</p></div><span class="role-badge">UPCOMING</span></article>
        <article><div class="experience-date">MAR 2026 — OCT 30, 2026</div><div><h3>Business Development &amp; Customer Success</h3><p class="experience-company">EZsalt · SaaS startup</p><p>I support about 100 customer accounts through check-ins, training, and technical troubleshooting. I coordinate with customer success management to resolve concerns and use HubSpot and AI-assisted workflows to automate follow-up, prepare for meetings, and research prospective customers.</p><div class="experience-results"><span><strong>75%</strong> of follow-up workflows automated</span><span><strong>1+ hour</strong> saved daily across a three-person team</span></div><details><summary>More about the work</summary><ul><li>Coordinate customer training, weekly check-ins, and technical troubleshooting.</li><li>Cut meeting prep from 5–10 minutes to 1–2 minutes with AI research and recap workflows.</li><li>Research 300+ prospect accounts weekly and generate an average of two meetings daily through calls, visits, and email sequences.</li></ul></details></div></article>
        <article><div class="experience-date">SEP 2026 — PRESENT</div><div><h3>Teaching Assistant</h3><p class="experience-company">IS 581: Managing a Software Startup · BYU</p><p>I review projects, give feedback, and grade coursework. I also help develop a Software Startup Simulation that teaches validated learning through product, technical, marketing, and resource decisions.</p></div></article>
        <article><div class="experience-date">EXPECTED APR 2028</div><div><h3>B.S. Information Systems</h3><p class="experience-company">Brigham Young University · Marriott School of Business</p><p>GPA: {profile.gpa} · Association for Information Systems</p><p>Coursework in databases, web development, and cloud systems, with electives in AI, product development, and software startups.</p></div></article>
        <article><div class="experience-date">AUG 2022 — AUG 2024</div><div><h3>Full-Time Missionary</h3><p class="experience-company">The Church of Jesus Christ of Latter-day Saints · Philippines</p><p>I learned Tagalog, trained and led other missionaries, and built cross-cultural communication, resilience, and self-direction.</p></div></article>
      </div>
    </div>
  </section>

  <section class="toolkit-v2"><div class="container"><div class="toolkit-layout"><h2>Skills</h2><div>{skills.map(group=><article><h3>{group.title}</h3><p>{group.items.join(' / ')}</p></article>)}</div></div></div></section>
  <section class="personal-v2"><div class="container personal-v2-grid"><img src="/images/lot-snowboarding.webp" alt="Lot standing with his snowboard at a snowy mountain resort." width="828" height="826" loading="lazy" /><div><h2>Outside work.</h2><p>Snowboarding, dirt biking, and time outdoors with my wife, friends, and family.</p><a class="arrow-link" href="/about/">About me <span>↗</span></a></div></div></section>
  <section class="contact-v2"><div class="container"><h2>Let’s connect.</h2><div><a href="/contact/">Contact form ↗</a></div></div></section>
</BaseLayout>
