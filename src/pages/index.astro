---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Callout from '../components/Callout.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';

const completedProjects = projects.filter((project) => project.status === 'Completed');
---

<BaseLayout title={profile.name} description="Lot Holmstead is an Information Systems student at Brigham Young University. See his experience, completed projects, resume, and current work.">
  <section class="hero simple-hero">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Lot Holmstead</p>
        <h1>Information Systems student at BYU.</h1>
        <p class="hero-intro">I’m studying in the Marriott School of Business, working in sales development at EZsalt, and building skills in product, web development, databases, and automation.</p>
        <p class="hero-details">
          <span><strong>Target:</strong> Product management and technical-business internships</span>
          <span><strong>Graduating:</strong> April 2028</span>
          <span><strong>Contact:</strong> <a href={`mailto:${profile.email}`}>{profile.email}</a></span>
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/#experience">What I’ve done</a>
          <a class="button button-secondary" href="/now/">What I’m working on</a>
        </div>
        <div class="profile-links" aria-label="Professional profiles">
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={profile.links.handshake} target="_blank" rel="noreferrer">Handshake ↗</a>
        </div>
      </div>
      <div class="hero-portrait reveal delay-one">
        <PhotoPlaceholder label="Professional headshot" note="Your headshot will replace this placeholder." tall />
      </div>
    </div>
  </section>

  <section class="quick-facts" aria-label="Current information">
    <div class="container quick-facts-grid">
      <div><span>Studying</span><strong>Information Systems</strong><small>BYU Marriott School</small></div>
      <div><span>Working</span><strong>EZsalt</strong><small>Sales development</small></div>
      <div><span>Graduating</span><strong>April 2028</strong><small>Provo, Utah</small></div>
      <div><span>Interested in</span><strong>Product & technology</strong><small>AI, startups, and operations</small></div>
    </div>
  </section>

  <section class="section section-white" id="experience">
    <div class="container simple-section-heading">
      <p class="eyebrow">Experience</p>
      <h2>Where I am now and what I’ve done.</h2>
    </div>
    <div class="container simple-timeline">
      <article>
        <div class="timeline-date">2026 — Present</div>
        <div>
          <p class="card-kicker">Work</p>
          <h3>Sales Development Representative · EZsalt</h3>
          <p>I research prospective customers, manage outreach and follow-up in HubSpot, present software solutions, and use AI tools to make research and sales processes faster and more consistent.</p>
          <ul class="plain-results">
            <li>Automated 75% of follow-up workflows in HubSpot.</li>
            <li>Helped save more than one hour of research time daily across a three-person team.</li>
            <li>Research 300+ accounts weekly and average two meetings generated per day.</li>
          </ul>
        </div>
      </article>
      <article>
        <div class="timeline-date">Expected 2028</div>
        <div>
          <p class="card-kicker">Education</p>
          <h3>B.S. Information Systems · Brigham Young University</h3>
          <p>I’m studying product management, databases, web development, cloud systems, and the ways technology supports real business decisions.</p>
          <p class="subtle-detail">Marriott School of Business · GPA 3.62 · Association for Information Systems</p>
        </div>
      </article>
      <article>
        <div class="timeline-date">2022 — 2024</div>
        <div>
          <p class="card-kicker">Service</p>
          <h3>Full-Time Missionary · Philippines</h3>
          <p>I learned Tagalog, trained other missionaries, worked with local communities, and developed stronger communication, leadership, and self-direction.</p>
        </div>
      </article>
    </div>
    <div class="container section-action"><a class="text-link" href="/resume/">View my full resume <span>→</span></a></div>
  </section>

  <section class="section projects-home" id="projects">
    <div class="container simple-section-heading heading-with-link">
      <div><p class="eyebrow">Completed projects</p><h2>A few things I’ve built.</h2></div>
      <a class="text-link" href={profile.links.github} target="_blank" rel="noreferrer">Visit GitHub <span>↗</span></a>
    </div>
    <div class="container project-grid home-project-grid">
      {completedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="container current-work-note">
      <p><strong>See what I’m building currently.</strong> I keep unfinished projects and current learning separate from completed portfolio work.</p>
      <a class="button button-secondary" href="/now/">What I’m up to</a>
    </div>
  </section>

  <section class="section section-white direction-section">
    <div class="container direction-grid">
      <div>
        <p class="eyebrow">Where I’m headed</p>
        <h2>I want to work where people, products, and technology meet.</h2>
      </div>
      <div>
        <p>I’m working toward product management and other technical-business roles where I can understand customer problems, help teams build the right thing, and keep developing my technical skills.</p>
        <p>Long term, I want to lead products, build companies, and create technology that solves problems people actually care about.</p>
        <a class="text-link" href="/now/">Read about my current goals <span>→</span></a>
      </div>
    </div>
  </section>

  <Callout />
</BaseLayout>
