---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Callout from '../components/Callout.astro';
import { profile, skills } from '../data/profile';
import { projects } from '../data/projects';

const completedProjects = projects.filter((project) => project.status === 'Completed');
---

<BaseLayout title={profile.name} description="Lot Holmstead is an Information Systems student at Brigham Young University. See his experience, completed projects, resume, and current work.">
  <section class="hero simple-hero">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Lot Holmstead</p>
        <h1>Information Systems student at BYU.</h1>
        <p class="hero-intro">I’m an Information Systems student at BYU who uses AI and automation to improve how teams sell to and support customers. At EZsalt, I support customer accounts and build AI-assisted workflows that save our three-person team more than an hour a day. I also serve as a teaching assistant for IS 581: Managing a Software Startup.</p>
        <p class="hero-details">
          <span><strong>Target:</strong> Product management internships in 2027 and technical experience opportunities now</span>
          <span><strong>Graduating:</strong> April 2028</span>
          <span><strong>Personal:</strong> <a href={`mailto:${profile.email}`}>{profile.email}</a></span>
          <span><strong>School:</strong> <a href={`mailto:${profile.schoolEmail}`}>{profile.schoolEmail}</a></span>
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/#experience">What I’ve done</a>
          <a class="button button-secondary" href="/now/">What I’m working on</a>
        </div>
        <div class="profile-links" aria-label="Professional profiles">
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href={profile.links.handshake} target="_blank" rel="noreferrer">Handshake ↗</a>
        </div>
      </div>
      <div class="hero-portrait reveal delay-one">
        <img
          class="hero-photo"
          src="/images/lot-headshot.webp"
          alt="Professional headshot of Lot Holmstead."
          width="1000"
          height="1500"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section section-white" id="experience">
    <div class="container simple-section-heading">
      <p class="eyebrow">Experience</p>
      <h2>Where I am now and what I’ve done.</h2>
    </div>
    <div class="container simple-timeline">
      <article>
        <div class="timeline-date">Mar 2026 — Present</div>
        <div>
          <p class="card-kicker">Work</p>
          <h3 class="timeline-title">
            <span>Sales Development and Customer Success</span>
            <small>EZsalt · SaaS Startup</small>
          </h3>
          <p>At EZsalt, a small SaaS startup, I work across sales development and customer success. I help customers use the product, resolve technical questions, and improve the workflows our team relies on.</p>
          <ul class="plain-results">
            <li>Support about 100 customer accounts through weekly check-ins, product questions, and technical troubleshooting to help customers keep using and renewing their plans.</li>
            <li>Coordinate customer training meetings and work with customer success management to address concerns and reach solutions.</li>
            <li>Automated 75% of follow-up workflows in HubSpot, improving CRM consistency and cutting repetitive admin.</li>
            <li>Cut meeting prep from 5–10 minutes to 1–2 minutes with AI research and recap workflows, saving more than one hour daily across a three-person sales team.</li>
            <li>Research 300+ prospect accounts weekly with AI-assisted tools and generate an average of two meetings daily through calls, visits, and email sequences.</li>
          </ul>
        </div>
      </article>
      <article>
        <div class="timeline-date">Sep 2026 — Present</div>
        <div>
          <p class="card-kicker">Teaching</p>
          <h3 class="timeline-title">
            <span>Teaching Assistant</span>
            <small>IS 581: Managing a Software Startup · BYU Marriott School of Business</small>
          </h3>
          <p>I review student projects, give feedback, and grade coursework on managing a software startup. I also help develop the Software Startup Simulation, which teaches validated learning through product, technical, marketing, and resource decisions.</p>
        </div>
      </article>
      <article>
        <div class="timeline-date">Expected Apr 2028</div>
        <div>
          <p class="card-kicker">Education</p>
          <h3 class="timeline-title">
            <span>Bachelor of Science in Information Systems</span>
            <small>Brigham Young University · BYU Marriott School of Business</small>
          </h3>
          <p>My coursework includes databases, web development, and cloud systems. I’m also taking electives in AI, product development, and software startups.</p>
          <p class="subtle-detail">GPA: {profile.gpa} · Association for Information Systems</p>
        </div>
      </article>
      <article>
        <div class="timeline-date">Aug 2022 — Aug 2024</div>
        <div>
          <p class="card-kicker">Service</p>
          <h3 class="timeline-title"><span>Full-Time Missionary · Philippines</span><small>The Church of Jesus Christ of Latter-day Saints</small></h3>
          <p>I learned Tagalog, trained and led other missionaries, and built cross-cultural communication, resilience, and self-direction.</p>
        </div>
      </article>
    </div>
    <div class="container section-action"><a class="text-link" href="/resume/">View my full resume <span>→</span></a></div>
  </section>

  <section class="section projects-home" id="projects">
    <div class="container simple-section-heading heading-with-link">
      <div><p class="eyebrow">Completed projects</p><h2>A few things I’ve built.</h2></div>
      <a class="text-link" href={profile.links.github} target="_blank" rel="noreferrer">Visit GitHub <span>↗</span></a>
    </div>
    <div class="container project-grid home-project-grid">
      {completedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <div class="container current-work-note">
      <p><strong>See what I’m building currently.</strong> Projects I’m still working on are listed on my Now page.</p>
      <a class="button button-secondary" href="/now/">What I’m up to</a>
    </div>
  </section>

  <section class="section section-white skills-section">
    <div class="container skills-layout">
      <div>
        <p class="eyebrow">Skills</p>
        <h2>Tools and experience I bring to a team.</h2>
      </div>
      <div class="skill-stack">
        {skills.map((group, index) => (
          <article>
            <span class="skill-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-white direction-section">
    <div class="container direction-grid">
      <div>
        <p class="eyebrow">What I’m working toward</p>
        <h2>I’m working toward product management.</h2>
      </div>
      <div>
        <p>Right now, I’m looking for technical experience where I can keep learning and contribute to a team. For 2027, I’m working toward a product management internship.</p>
        <p>Long term, I’d like to work in product management, learn how tech companies are built, and eventually start a company of my own.</p>
        <a class="text-link" href="/now/">Read about my current goals <span>→</span></a>
      </div>
    </div>
  </section>

  <Callout />
</BaseLayout>
