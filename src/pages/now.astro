---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/Callout.astro';
import { projects } from '../data/projects';

const activeProjects = projects.filter((project) => project.status !== 'Completed');
---

<BaseLayout title="Now" description="See what Lot Holmstead is currently studying, building, learning, and working toward.">
  <section class="page-hero compact plain-page-hero now-page-hero">
    <img class="now-hero-photo" src="/images/byu-campus-now.webp" alt="" width="1200" height="799" decoding="async" fetchpriority="high" />
    <div class="container narrow">
      <h1>What I’m working on right now.</h1>
      <p class="page-intro">Here’s what I’m currently doing at school and work, what I’m building, and what I’m working toward. Updated September 2026.</p>
    </div>
  </section>

  <section class="section section-white now-section">
    <div class="container now-list">
      <article>
        <span class="now-number">01</span>
        <div><p class="card-kicker">School</p><h2>BYU Information Systems</h2><p>I’m in the junior core studying product management, databases, web development, and cloud systems. I’m also a teaching assistant for IS 581: Managing a Software Startup, where I review student projects, help run activities, provide feedback, grade coursework, and help develop the Software Startup Simulation.</p></div>
      </article>
      <article>
        <span class="now-number">02</span>
        <div><p class="card-kicker">Work</p><h2>EZsalt</h2><p>EZsalt is a SaaS startup with a team of about 10 people, which gives me the opportunity to contribute beyond a typical sales role. I talk directly with prospective customers, help the team understand what they need, and use HubSpot, AI, and automation to improve how we research accounts and manage outreach. Because the company is small, I also get to contribute as we test new technology and adjust our processes.</p></div>
      </article>
      <article>
        <span class="now-number">03</span>
        <div>
          <p class="card-kicker">Building</p><h2>Current projects</h2>
          <div class="now-projects">
            {activeProjects.map((project) => (
              <div><span>{project.status}</span><h3>{project.title}</h3><p>{project.summary}</p><div class="tag-list">{project.tags.map((tag) => <span>{tag}</span>)}</div></div>
            ))}
          </div>
        </div>
      </article>
      <article>
        <span class="now-number">04</span>
        <div><p class="card-kicker">Looking ahead</p><h2>Summer 2027 internship</h2><p>For summer 2027, I’m looking for product management internships. Right now, I’m also interested in technical experience where I can keep learning and contribute to a team.</p></div>
      </article>
      <article>
        <span class="now-number">05</span>
        <div><p class="card-kicker">Long term</p><h2>Product management and entrepreneurship</h2><p>Long term, I’d like to work in product management, learn how tech companies are built, and eventually start a company of my own.</p></div>
      </article>
    </div>
  </section>

  <Callout eyebrow="Opportunities" title="Have an opportunity I should know about?" body="Send me a message. I’d be glad to learn more about it." />
</BaseLayout>
