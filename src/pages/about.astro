---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import Callout from '../components/Callout.astro';
---

<BaseLayout title="About" description="Get to know Lot Holmstead—his background, family, mission in the Philippines, hobbies, and interests outside work and school.">
  <section class="about-mountain-hero">
    <div class="mountain-layer mountain-far"></div>
    <div class="mountain-layer mountain-near"></div>
    <div class="container about-hero-content">
      <p class="eyebrow">About me</p>
      <h1>I’m Lot Holmstead.</h1>
      <p>Student, husband, builder, and outdoors enthusiast from Utah.</p>
      <span class="image-note">Mount Timpanogos photography will replace this mountain placeholder.</span>
    </div>
  </section>

  <section class="section section-white">
    <div class="container story-grid simple-story">
      <div class="story-photo"><PhotoPlaceholder label="A photo of me" note="A natural portrait or Jeep photo will go here." tall /></div>
      <div class="story-copy">
        <p class="eyebrow">A little about me</p>
        <h2>I like learning how things work and finding better ways to do them.</h2>
        <p>I live in Springville, Utah, with my wife and attend Brigham Young University in Provo. I’m studying Information Systems because it brings together several things I enjoy: technology, business, people, and problem solving.</p>
        <p>I’m interested in product management, startups, AI, automation, and entrepreneurship. I’m also still early in that path. Right now, I’m focused on learning, building projects, meeting good people, and getting experience on strong teams.</p>
        <p>Outside school and work, I would rather be doing something active—snowboarding, dirt biking, boating, hiking, golfing, traveling, or spending time with family.</p>
      </div>
    </div>
  </section>

  <section class="section personal-gallery-section">
    <div class="container simple-section-heading">
      <p class="eyebrow">Life outside work</p>
      <h2>The people and places that matter to me.</h2>
      <p class="heading-note">These placeholders are mapped to the exact photos you plan to send.</p>
    </div>
    <div class="container personal-gallery">
      <div class="gallery-wide"><PhotoPlaceholder label="Snowboarding" note="Snowboarding photo" tall /></div>
      <PhotoPlaceholder label="Dirt biking" note="Dirt biking photo" />
      <PhotoPlaceholder label="My Jeep" note="Photo in or with the Jeep" />
      <div class="gallery-wide"><PhotoPlaceholder label="My wife and me" note="Wedding photo" tall /></div>
      <PhotoPlaceholder label="The Philippines" note="Mission photo" />
    </div>
  </section>

  <section class="section section-white mission-about">
    <div class="container mission-grid">
      <div>
        <p class="eyebrow">The Philippines</p>
        <h2>Two years of service changed how I see people and responsibility.</h2>
        <p>From August 2022 to August 2024, I served as a missionary for The Church of Jesus Christ of Latter-day Saints in the Philippines.</p>
        <p>I learned Tagalog, trained other missionaries, worked in unfamiliar environments, and met people with backgrounds very different from mine. It taught me patience, resilience, confidence, and how important it is to listen before trying to help.</p>
      </div>
      <PhotoPlaceholder label="Mission in the Philippines" note="A favorite mission photo will replace this." />
    </div>
  </section>

  <Callout eyebrow="Contact" title="Thanks for getting to know me." body="If you’d like to talk about an opportunity, a project, or a shared interest, feel free to reach out." />
</BaseLayout>
