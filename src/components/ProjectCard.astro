---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  large?: boolean;
  compact?: boolean;
}

const { project, large = false, compact = false } = Astro.props;
const statusClass = project.status.toLowerCase().replace(' ', '-');
const responsiveImage = project.evidence?.image.replace(/\.webp$/, '-720.webp');
---

<article class:list={['project-card', `project-${project.slug}`, { large }]}>
  {project.evidence && (
    <a class="project-screenshot" href={`/projects/${project.slug}/`} aria-label={`Explore ${project.title}`}>
      <img src={project.evidence.image} srcset={`${responsiveImage} 720w, ${project.evidence.image} 1440w`} sizes="(max-width: 760px) calc(100vw - 56px), (max-width: 1240px) calc(50vw - 76px), 580px" alt={project.evidence.imageAlt} width="1440" height="1000" loading="lazy" decoding="async" />
      <span class="project-visual-label" aria-hidden="true">{project.slug === 'cougar-crossing' ? 'PLAY / BUILD / ITERATE' : project.slug === 'starrboard' ? 'PLAN / PRIORITIZE / FOCUS' : 'PROJECT ARCHIVE'}</span>
    </a>
  )}
  <div class="project-body">
    <div class="project-meta">
      <span>{project.eyebrow}</span>
      <span class:list={['status', statusClass]}>{project.status}</span>
    </div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <div class="tag-list" aria-label="Project technologies">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
    {!compact && <p class="project-note">{project.detail}</p>}
    {!compact && project.outcome && <p class="project-outcome"><strong>Evidence:</strong> {project.outcome}</p>}
    {compact ? (
      ['cougar-crossing', 'starrboard'].includes(project.slug) && <div class="project-links project-action-links">
        {project.demo ? <a href={project.demo} target="_blank" rel="noreferrer">{project.demoLabel ?? 'View live project'} ↗</a> : <a href={`/projects/${project.slug}/`}>View case study →</a>}
      </div>
    ) : (
      <div class="project-links">
        {project.evidence && <a href={`/projects/${project.slug}/`}>Project details →</a>}
        {project.caseStudy && <a href={project.caseStudy} target="_blank" rel="noreferrer">Case study ↗</a>}
        {project.github && <a href={project.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
        {project.demo && <a href={project.demo} target="_blank" rel="noreferrer">{project.demoLabel ?? 'Live site'} ↗</a>}
        {!project.github && !project.demo && <span>Links will be added as the project develops.</span>}
      </div>
    )}
  </div>
</article>
